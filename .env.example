# Copie para .env.local (que NÃO vai para o Git) e ajuste.
# Valores públicos: tudo com NEXT_PUBLIC_ é embutido no site e visível a qualquer visitante.
# NUNCA coloque aqui chave secreta ou service_role.

# Vazio em domínio próprio; "/nome-do-repo" em usuario.github.io/nome-do-repo/
NEXT_PUBLIC_BASE_PATH=

# URL pública completa, SEM barra final e COM o subdiretório, se houver.
# Ex.: https://usuario.github.io/nome-do-repo  ou  https://www.dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só "true" na publicação final, com conteúdo real.
NEXT_PUBLIC_ALLOW_INDEXING=false
